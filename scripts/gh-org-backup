#!/usr/bin/env bash
# Back up every GitHub repo you can read in one org (or your account) into a single zip.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: gh-org-backup [--list | --org NAME] [options]

  --list          Print your account and your orgs, one per line, then exit.
  --org NAME      Back up every repo NAME holds that you can read. Your own login
                  means every repo you can access: owned, collaborator, org member.
  --out DIR       Where the zip goes (default: current directory).
  --keep          Keep the unzipped clones next to the zip.
  --no-archived   Skip archived repos.
  --no-forks      Skip forks.
  -j N            Parallel clones (default: 4).

With no --list/--org in a terminal, shows a picker.
EOF
}

die() { echo "gh-org-backup: $*" >&2; exit 1; }

need() { command -v "$1" >/dev/null || die "$1 not found. macOS: brew install $1. Else your package manager (gh: https://cli.github.com)."; }

auth() {
  if ! gh auth status -h github.com >/dev/null 2>&1; then
    echo "Not logged in to GitHub. Opening browser login..." >&2
    gh auth login -h github.com --web -p https -s repo,read:org
  fi
  [[ -n "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]] && return
  local scopes
  scopes=$(gh api -i user 2>/dev/null | tr -d '\r' | sed -n 's/^[Xx]-[Oo]auth-[Ss]copes: //p')
  [[ -n $scopes ]] || return 0
  scopes=",${scopes// /},"
  if [[ $scopes != *,repo,* || ( $scopes != *,read:org,* && $scopes != *,admin:org,* ) ]]; then
    echo "GitHub token lacks repo/read:org scopes. Opening browser to grant them..." >&2
    gh auth refresh -h github.com -s repo,read:org
  fi
}

list_owners() {
  echo "$me"
  gh api --paginate 'user/orgs?per_page=100' -q '.[].login'
}

list_repos() {
  local filter='.[]'
  [[ $no_archived ]] && filter+=' | select(.archived | not)'
  [[ $no_forks ]] && filter+=' | select(.fork | not)'
  filter+=' | .full_name'
  if [[ $1 == "$me" ]]; then
    gh api --paginate 'user/repos?affiliation=owner,collaborator,organization_member&per_page=100' -q "$filter"
  else
    gh api --paginate "orgs/$1/repos?type=all&per_page=100" -q "$filter"
  fi
}

clone_one() {
  local repo=$1 dir="$STAGE/$1" err
  mkdir -p "$(dirname "$dir")"
  if ! err=$(git -c credential.helper= -c 'credential.helper=!gh auth git-credential' \
      clone -q "https://github.com/$repo.git" "$dir" 2>&1); then
    printf '%s: %s\n' "$repo" "$(tail -n1 <<<"$err")" >>"$FAILED"
    return 0
  fi
  git -C "$dir" for-each-ref --format='%(refname:strip=3)' refs/remotes/origin |
    while read -r b; do
      [[ $b == HEAD || $b == "$(git -C "$dir" branch --show-current)" ]] && continue
      git -C "$dir" branch -q --track "$b" "origin/$b" 2>/dev/null ||
        echo "  warn $repo: branch $b kept only as origin/$b (name collision)" >&2
    done
  echo "  ok  $repo" >&2
}

mode='' org='' out=. keep='' no_archived='' no_forks='' jobs=4
while (($#)); do
  case $1 in
    --list) mode=list ;;
    --org) org=${2:?--org needs a name}; mode=org; shift ;;
    --out) out=${2:?--out needs a dir}; shift ;;
    --keep) keep=1 ;;
    --no-archived) no_archived=1 ;;
    --no-forks) no_forks=1 ;;
    -j) jobs=${2:?-j needs a number}; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

need gh; need git; need zip
auth
me=$(gh api user -q .login)

if [[ $mode == list ]]; then list_owners || die "could not list orgs"; exit 0; fi

if [[ -z $mode ]]; then
  [[ -t 0 ]] || { usage >&2; exit 2; }
  owners_list=$(list_owners) || die "could not list orgs"
  owners=(); while IFS= read -r owner; do owners+=("$owner"); done <<<"$owners_list"
  PS3="Back up which account/org? "
  select org in "${owners[@]}"; do [[ -n $org ]] && break; done
  [[ -n $org ]] || exit 1
fi

mkdir -p "$out"
out=$(cd "$out" && pwd)
name="$org-$(date +%Y%m%d-%H%M)"
STAGE="$out/$name"
FAILED=$(mktemp)
ZIP="$out/$name.zip"
[[ -e $STAGE || -e $ZIP ]] && die "$STAGE or $ZIP already exists"
trap 'rm -f "$FAILED"; [[ $keep ]] || rm -rf "$STAGE"' EXIT

repo_list=$(list_repos "$org") || die "could not list repos for $org (see gh error above)"
[[ -n $repo_list ]] || die "no readable repos for $org"
total=$(wc -l <<<"$repo_list" | tr -d ' ')
echo "Cloning $total repos from $org into $STAGE ($jobs at a time)..." >&2

mkdir -p "$STAGE"
export STAGE FAILED GIT_TERMINAL_PROMPT=0 GIT_LFS_SKIP_SMUDGE=1
export -f clone_one
# shellcheck disable=SC2016
xargs -P "$jobs" -I{} bash -c 'clone_one "$1"' _ {} <<<"$repo_list"

echo "Zipping..." >&2
(cd "$STAGE" && zip -qry "$ZIP" .)

echo "Done: $(( total - $(wc -l <"$FAILED") ))/$total repos in $ZIP"
if [[ -s $FAILED ]]; then
  echo "Failed:" >&2
  cat "$FAILED" >&2
  exit 3
fi
